#!/bin/sh

set -eu

binary=${1:-.build/release/swm}

fail() {
  printf 'smoke test failed: %s\n' "$1" >&2
  exit 1
}

if [ ! -x "$binary" ]; then
  fail "binary is not executable: $binary"
fi

"$binary" --help >/dev/null || fail "--help exited unsuccessfully"
"$binary" help window move >/dev/null || fail "help window move exited unsuccessfully"

version=$("$binary" --version) || fail "--version exited unsuccessfully"
case $version in
  'swm version v'*) ;;
  *) fail "unexpected version output: $version" ;;
esac

if "$binary" -m query --windows >/dev/null 2>&1; then
  fail "removed -m syntax exited successfully"
fi

printf 'release CLI smoke test passed\n'
